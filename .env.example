# Toutes les variables sont optionnelles en local : sans elles, le prototype utilise
# une base Postgres embarquée (PGlite, dans .data/) et un stockage disque pour les photos.

# Production — obligatoire
JWT_SECRET=

# Base de données Neon (sinon PGlite local)
DATABASE_URL=

# Stockage des photos sur Vercel Blob (sinon .data/uploads)
BLOB_READ_WRITE_TOKEN=

# Scan automatique des images négatives (Google Custom Search)
GOOGLE_CSE_ID=
GOOGLE_SEARCH_API_KEY=
# Déclenchement du crawler par Vercel Cron / admin
CRON_SECRET=
